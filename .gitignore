.DS_Store
node_modules/

# Vite output for the Underground Cafe site. Built in CI by the Pages
# workflow and swapped in for `underground/`, so it is never committed.
underground-dist/

# Single-file inlined builds, generated for previewing the site: one for
# a `file://` URL, one shaped for publishing as a hosted artifact. Both
# are derived from underground-dist/, so neither is committed.
underground-preview.html
underground-artifact.html
